# Copy this file to .env and fill in the values. The .env file is never committed.

# --- Database (running without Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=wallet_fraud_db

# --- Web application ---
PORT=3000
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
ML_URL=http://127.0.0.1:8000
# Optional. Other origins allowed to call the API, comma-separated. Leave unset.
# CORS_ORIGIN=
# Optional. Size of the database connection pool (default 10).
# DB_CONN_LIMIT=10

# --- Risk engine (version 2) ---
# advisory: every payment completes; risky ones are flagged for review.
# enforce:  unusual payments need the transaction PIN; high-risk ones are held.
RISK_MODE=advisory
# 1 switches on the attack lab for administrators. Leave at 0 when deployed.
ATTACK_LAB=0

# --- Production only ---
# NODE_ENV=production
# DOMAIN=wallet.example.com

# --- Scoring service administration (version 3) ---
# Shared secret the website sends to the scoring service with retrain,
# promote and rollback requests. Set the same value for both services.
# Without it the scoring service accepts those requests from localhost only.
ML_ADMIN_TOKEN=change-me
# Optional. Folder where the scoring service keeps the champion, the
# challenger and earlier models (default: the ml folder).
# MODEL_DIR=

# --- Security (version 3) ---
# optional: administrators may set up two-step sign-in.
# required: the admin console refuses an administrator until they have.
ADMIN_2FA=optional
# Optional. Key used to encrypt two-step sign-in secrets in the database
# (default: derived from SESSION_SECRET). Generate one as for SESSION_SECRET.
# TOTP_ENCRYPTION_KEY=
# Optional. Bearer token a monitoring tool uses to read GET /metrics.
# Administrators signed in to the console can always read it.
# METRICS_TOKEN=

# --- Payment protection (version 3, enforce mode) ---
# Releasing a held payment, or a dispute refund, of this many shillings or
# more needs a second administrator to approve it.
TWO_PERSON_THRESHOLD=10000
# A first transfer to someone of this amount or more asks what it is for.
SCAM_CHECK_MIN=1000
# A payment whose stated purpose matches a common scam waits this long
# before it leaves, and the sender can cancel it meanwhile.
COOLING_OFF_MINUTES=30
# Hour of the day (0 to 23, server time) of the nightly reconciliation.
RECONCILE_HOUR=2

# --- M-Pesa (version 3) ---
# simulator: deposits through M-Pesa are simulated on the site (default).
# sandbox:   STK push requests go to Safaricom's Daraja sandbox. Needs the
#            values below from developer.safaricom.co.ke and PUBLIC_URL.
MPESA_MODE=simulator
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# A random string of at least 32 characters, part of the callback address
# Safaricom calls. Required in sandbox mode; without it the simulator uses a
# random token that changes on every restart.
# MPESA_CALLBACK_TOKEN=
# Optional. Daraja base address (default: the sandbox).
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# The site's public https address, for callbacks.
# PUBLIC_URL=https://wallet.example.com

# --- USSD (version 3) ---
# 1 switches on the USSD simulator page (ussd.html). Leave at 0 when deployed.
USSD_SIMULATOR=0
# A long random string; the Africa's Talking callback address is
#   <PUBLIC_URL>/api/ussd/callback/<USSD_CALLBACK_TOKEN>
# USSD_CALLBACK_TOKEN=

# --- Fraud API webhooks (version 3) ---
# 1 allows webhook addresses on private networks (localhost, 10.x and so on).
# Only for testing with scripts/webhook-receiver.js; leave unset in production.
# WEBHOOK_ALLOW_PRIVATE=1

# --- Development only ---
# 1 stops the background workers (reconciliation, webhooks, cooling-off).
# NO_WORKERS=1

# --- Scripts (set in the shell, not needed by the server) ---
# TEST_BASE_URL       address the test and load-test scripts use (default http://localhost:3000)
# SECUREWALLET_KEY    a fraud API key, for scripts/api-demo.js
# WEBHOOK_SECRET      a client's webhook secret, for scripts/webhook-receiver.js
# In PowerShell set one with:  $env:SECUREWALLET_KEY = "swk_live_..."
